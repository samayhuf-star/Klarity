{
  "expo": {
    "name": "Klarity",
    "slug": "klarity",
    "scheme": "klarity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1514",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samayhuf.klarity",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram",
          "tiktok",
          "youtube",
          "twitter",
          "reddit",
          "snapchat",
          "fb",
          "whatsapp",
          "nflx",
          "pinterest",
          "linkedin",
          "barcelona",
          "discord",
          "telegram"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#5FB59D"
        }
      ]
    ],
    "owner": "krosz",
    "extra": {
      "eas": {
        "projectId": "6669c37d-a24f-4e6c-b6e3-db2a85778def"
      },
      "privacyPolicyUrl": "https://samayhuf-star.github.io/Klarity/privacy.html"
    },
    "android": {
      "package": "com.samayhuf.klarity"
    },
    "description": "Klarity adds a calm pause before the apps you open on autopilot. Everything stays on your iPhone."
  }
}
